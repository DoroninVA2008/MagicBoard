{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "src",
    "publicUrl": "public",
    "strict": true,
    "paths": {
      "@/*": [ "/*" ],
      "#/*": ["../public/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts", 
    "src/widgets/footer/footer.tsx", "src/pages/home/api/index.tsx"  ]
}